import requests

# ================= [ 설정 영역 ] =================
GITHUB_TOKEN = "여기에_깃허브_토큰_입력"
USERNAME = "여기에_깃허브_아이디_입력"
KEYWORD = "test"  # 정리하고 싶은 레포지토리 키워드 (예: test, dummy, hello)
# =================================================

headers = {
    "Authorization": f"Bearer {GITHUB_TOKEN}",
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
}

def get_repositories():
    """사용자의 전체 레포지토리 목록을 가져옵니다."""
    url = f"https://api.github.com/users/{USERNAME}/repos?per_page=100"
    response = requests.get(url, headers=headers)
    if response.status_code == 200:
        return response.json()
    else:
        print(f"❌ 레포지토리 목록을 가져오는데 실패했습니다. (에러 코드: {response.status_code})")
        return []

def clean_repositories():
    repos = get_repositories()
    # 이름에 키워드가 포함된 레포지토리만 필터링 (대소문자 구분 없음)
    target_repos = [r for r in repos if KEYWORD in r['name'].lower()]

    if not target_repos:
        print(f"💡 이름에 '{KEYWORD}'가 포함된 레포지토리를 찾지 못했습니다.")
        return

    print(f"\n📢 [조회 완료] '{KEYWORD}'가 포함된 레포지토리 ({len(target_repos)}개)")
    for r in target_repos:
        print(f" 📦 {r['name']} -> {r['html_url']}")
    
    print("\n⚠️  주의: 삭제(delete)는 되돌릴 수 없습니다. 안전하게 보관(archive)하는 것을 권장합니다.")
    action = input("👉 원하는 작업을 선택하세요 (archive / delete / cancel): ").strip().lower()

    if action not in ['archive', 'delete']:
        print("❌ 작업이 취소되었습니다.")
        return

    # 최종 확인 단계
    confirm = input(f"❗ 실제로 위 {len(target_repos)}개의 레포지토리를 {action} 하시겠습니까? (yes/no): ").strip().lower()
    if confirm != 'yes':
        print("❌ 최종 확인을 하지 않아 작업이 취소되었습니다.")
        return

    for r in target_repos:
        repo_name = r['name']
        url = f"https://api.github.com/repos/{USERNAME}/{repo_name}"
        
        if action == 'archive':
            # 레포지토리 보관(읽기 전용 전환) API
            res = requests.patch(url, headers=headers, json={"archived": True})
            if res.status_code == 200:
                print(f"✅ [보관 완료] {repo_name}")
            else:
                print(f"❌ [보관 실패] {repo_name} (코드: {res.status_code})")
        
        elif action == 'delete':
            # 레포지토리 영구 삭제 API
            res = requests.delete(url, headers=headers)
            if res.status_code == 204:
                print(f"🔥 [삭제 완료] {repo_name}")
            else:
                print(f"❌ [삭제 실패] {repo_name} (코드: {res.status_code})")

if __name__ == "__main__":
    clean_repositories()
