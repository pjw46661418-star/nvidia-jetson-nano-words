import os
import time
import torch
import torch.nn as nn
import torch.optim as optim
import torchvision.transforms as transforms
import torchvision.models as models
from torchvision.datasets import ImageFolder
from torch.utils.data import DataLoader
import torch.nn.functional as F

# ==========================================
# 1. 환경 설정 및 하이퍼파라미터 (Screenshot 3, 4)
# ==========================================
DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
DATASET_DIR = 'dataset'  # thumbs_up, thumbs_down 폴더가 위치한 경로
BATCH_SIZE = 8
EPOCHS = 10
NUM_CLASSES = 2  # thumbs_up, thumbs_down

print(f"🚀 현재 사용 중인 디바이스: {DEVICE}")

# ==========================================
# 2. 모델 정의: ResNet-18 전이 학습 (Screenshot 3)
# ==========================================
def get_model(num_classes):
    # 사전 훈련된 ResNet-18 모델 로드
    model = models.resnet18(pretrained=True)
    
    # 마지막 Fully Connected 레이어를 우리의 클래스 수(2개)에 맞게 변경
    num_ftrs = model.fc.in_features
    model.fc = nn.Linear(num_ftrs, num_classes)
    
    return model.to(DEVICE)

# ==========================================
# 3. 데이터 전처리 및 로더 설정
# ==========================================
# Jetson Nano 카메라 입력 크기에 맞춘 전처리 (224x224)
data_transforms = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])
])

def get_data_loader(data_dir, batch_size):
    if not os.path.exists(data_dir):
        raise FileNotFoundError(f"❌ '{data_dir}' 폴더가 없습니다. 데이터를 먼저 수집해주세요.")
    
    dataset = ImageFolder(root=data_dir, transform=data_transforms)
    loader = DataLoader(dataset, batch_size=batch_size, shuffle=True, num_workers=0)
    return loader, dataset.classes

# ==========================================
# 4. 모델 트레이닝 함수 (Screenshot 4, 7)
# ==========================================
def train_model(model, train_loader, epochs=10):
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001)
    
    model.train()
    print("\n🏋️ 학습을 시작합니다...")
    
    for epoch in range(epochs):
        running_loss = 0.0
        running_corrects = 0
        
        for inputs, labels in train_loader:
            inputs, labels = inputs.to(DEVICE), labels.to(DEVICE)
            
            optimizer.zero_grad()
            
            outputs = model(inputs)
            loss = criterion(outputs, labels)
            _, preds = torch.max(outputs, 1)
            
            loss.backward()
            optimizer.step()
            
            running_loss += loss.item() * inputs.size(0)
            running_corrects += torch.sum(preds == labels.data)
            
        epoch_loss = running_loss / len(train_loader.dataset)
        epoch_acc = running_corrects.double() / len(train_loader.dataset)
        
        print(f"Epoch {epoch+1}/{epochs} -> Loss: {epoch_loss:.4f} | Accuracy: {epoch_acc:.4f}")
        
    print("✅ 학습 완료!")

# ==========================================
# 5. 실시간 추론 및 Softmax 처리 (Screenshot 3, 8)
# ==========================================
def predict_live_frame(model, PIL_image, class_names):
    """
    실시간 카메라 프레임(PIL Image 형태)을 받아 클래스 확률을 반환합니다.
    """
    model.eval()
    
    # 이미지 전처리 및 배치 차원 추가
    input_tensor = data_transforms(PIL_image).unsqueeze(0).to(DEVICE)
    
    with torch.no_grad():
        output = model(input_tensor)
        # Softmax 함수를 통과시켜 확률 분포로 변환 (Screenshot 3번 공식 반영)
        probabilities = F.softmax(output, dim=1).detach().cpu().numpy().flatten()
        
    # 결과 출력
    for idx, class_name in enumerate(class_names):
        print(f"📊 {class_name}: {probabilities[idx]*100:.2f}%")
        
    return probabilities

# ==========================================
# 6. 모델 저장 및 로드 (Screenshot 8)
# ==========================================
def save_model(model, path="my_model.pth"):
    torch.save(model.state_dict(), path)
    print(f"💾 모델이 성공적으로 저장되었습니다: {path}")

if __name__ == "__main__":
    # 실행 흐름 예시 (데이터가 수집되어 폴더 구조가 잡혀있어야 작동합니다)
    try:
        # 1. 데이터 로더 준비
        train_loader, classes = get_data_loader(DATASET_DIR, BATCH_SIZE)
        print(f"📂 탐지된 클래스: {classes}")
        
        # 2. 모델 생성
        my_resnet = get_model(num_classes=len(classes))
        
        # 3. 학습 진행
        train_model(my_resnet, train_loader, epochs=EPOCHS)
        
        # 4. 모델 저장
        save_model(my_resnet, "my_model.pth")
        
    except Exception as e:
        print(e)
